</fo:inline></fo:inline></fo:block></fo:block><fo:block id="id4"><fo:block><fo:block><fo:block keep-together.within-column="always" margin-left="0pt" font-family="sans-serif,Symbol,ZapfDingbats"><fo:block keep-with-next.within-column="always"><fo:block font-family="sans-serif" font-weight="bold" keep-with-next.within-column="always" space-before.minimum="0.8em" space-before.optimum="1.0em" space-before.maximum="1.2em" text-align="start" start-indent="0pt"><fo:marker marker-class-name="section.head.marker">========== Part 2: Maximum Likelihood &amp; Gradient Ascent =============</fo:marker><fo:block font-size="20.736pt">========== Part 2: Maximum Likelihood &amp; Gradient Ascent =============</fo:block></fo:block></fo:block></fo:block></fo:block></fo:block><fo:block text-align="start" wrap-option="wrap" space-before.minimum="0.8em" space-before.optimum="1em" space-before.maximum="1.2em" space-after.minimum="0.8em" space-after.optimum="1em" space-after.maximum="1.2em" hyphenate="false" white-space-collapse="false" white-space-treatment="preserve" linefeed-treatment="preserve" font-family="monospace" id="id18">fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'===== Part 2: Maximum Likelihood &amp; Gradient Ascent ===== \n'</fo:inline>);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Instructions: The following code applies gradient ascent to</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               estimate the parameters in a logistic regression</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               model based on the idea of maximum likelihood estimation.</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               You should complete code in gradientAscent.m,</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               likelihoodFunction.m</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               Try running gradient ascent with</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               different values of alpha and see which one gives</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               you the best result.</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>


<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ====================== YOUR CODE HERE ======================</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Step 1: Configure the hyper-parameters, including</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%         1. alpha: learning rate</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%         2. num_iters: number of training iterations</fo:inline>
alpha = 0.1 <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% you should change this</fo:inline>
num_iters = 1000 <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% you should change this</fo:inline>

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Initialize beta</fo:inline>
beta = zeros(m+1, 1);


<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ====================== YOUR CODE HERE ======================</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Step 2: Run Gradient Descent</fo:inline>
[beta, l_history] = gradientAscent(Xn_train, y_train, beta, alpha, num_iters);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Plot the convergence graph</fo:inline>
figure;
plot(1:numel(l_history), l_history, <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'-b'</fo:inline>, <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'LineWidth'</fo:inline>, 2);
xlabel(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'Number of iterations'</fo:inline>);
ylabel(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'log likelihood l'</fo:inline>);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Display gradient descent's result</fo:inline>
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'beta computed from gradient descent: \n'</fo:inline>);
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">' %f \n'</fo:inline>, beta);
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'\n'</fo:inline>);

fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'Program paused. Press enter to continue.\n'</fo:inline>);
pause;
</fo:block><fo:block text-align="start" wrap-option="wrap" space-before.minimum="0.8em" space-before.optimum="1em" space-before.maximum="1.2em" space-after.minimum="0.8em" space-after.optimum="1em" space-after.maximum="1.2em" hyphenate="false" white-space-collapse="false" white-space-treatment="preserve" linefeed-treatment="preserve" font-family="monospace" id="id19"><fo:inline font-family="monospace"><fo:inline font-style="italic">===== Part 2: Maximum Likelihood &amp; Gradient Ascent ===== 

