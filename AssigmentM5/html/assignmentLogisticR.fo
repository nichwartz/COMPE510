</fo:inline></fo:inline></fo:block><fo:block id="id21"><fo:external-graphic src="url(file:///C:/Users/nikcs/AppData/Local/Temp/assignmentLogisticR_01.png)" width="100%" content-width="scale-to-fit" content-height="100%" block-progression-dimension.maximum="627.264pt" inline-progression-dimension.maximum="100%"/></fo:block></fo:block><fo:block id="id5"><fo:block><fo:block><fo:block keep-together.within-column="always" margin-left="0pt" font-family="sans-serif,Symbol,ZapfDingbats"><fo:block keep-with-next.within-column="always"><fo:block font-family="sans-serif" font-weight="bold" keep-with-next.within-column="always" space-before.minimum="0.8em" space-before.optimum="1.0em" space-before.maximum="1.2em" text-align="start" start-indent="0pt"><fo:marker marker-class-name="section.head.marker">========== Part 3: Evaluate performance =================</fo:marker><fo:block font-size="20.736pt">========== Part 3: Evaluate performance =================</fo:block></fo:block></fo:block></fo:block></fo:block></fo:block><fo:block text-align="start" wrap-option="wrap" space-before.minimum="0.8em" space-before.optimum="1em" space-before.maximum="1.2em" space-after.minimum="0.8em" space-after.optimum="1em" space-after.maximum="1.2em" hyphenate="false" white-space-collapse="false" white-space-treatment="preserve" linefeed-treatment="preserve" font-family="monospace" id="id22">fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'===== Part 3: Evaluate Performance ===== \n'</fo:inline>);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Instructions: The following code evaluates the performance of</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               the trained logistic regression model. You should</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">%               complete code in evaluateAccuracy.m, predict.m, and sigmoid.m</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>



<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ====================== YOUR CODE HERE ======================</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Step 1: Evaluate the performance of the trained model</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Hint: The testing set also needs to be normlized first</fo:inline>
num_test = size(X_test,1);

Xn_test= (X_test - mu) ./ sigma; <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% you should change this</fo:inline>
Xn_test = [ones(num_test,1) Xn_test];
accuracy = evaluateAccuracy(beta, Xn_test, y_test);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Display the prediction accuracy</fo:inline>
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'Accuracy:\n %f\n'</fo:inline>, accuracy);
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'\n'</fo:inline>);

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ====================== YOUR CODE HERE ======================</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% Step 2: Given a new input x = [3, 100, 79, 19, 100, 36, 0.8, 30], predict the output</fo:inline>

x_new = ([3, 100, 79, 19, 100, 36, 0.8, 30]- mu )./sigma; <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% You should change this</fo:inline>
x_new = [1 x_new];
y_new = predict(beta, x_new); <fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% You should change this</fo:inline>

<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% ============================================================</fo:inline>
<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#028009">% display the predicted output</fo:inline>
fprintf(<fo:inline xmlns:mwsh="http://www.mathworks.com/namespace/mcode/v1/syntaxhighlight.dtd" color="#aa04f9">'Predicted output:\n %d\n'</fo:inline>, y_new);
</fo:block><fo:block text-align="start" wrap-option="wrap" space-before.minimum="0.8em" space-before.optimum="1em" space-before.maximum="1.2em" space-after.minimum="0.8em" space-after.optimum="1em" space-after.maximum="1.2em" hyphenate="false" white-space-collapse="false" white-space-treatment="preserve" linefeed-treatment="preserve" font-family="monospace" id="id23"><fo:inline font-family="monospace"><fo:inline font-style="italic">===== Part 3: Evaluate Performance ===== 
